{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["Sombrius"],
  "contributors": ["Vladeezyy (port to NeoForge and Fabric)"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/the-deep-void",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.sombrius.thedeepvoid.fabric.TheDeepVoidFabric"],
    "client": ["net.sombrius.thedeepvoid.fabric.TheDeepVoidFabricClient"],
    "jei_mod_plugin": ["net.sombrius.thedeepvoid.init.TheDeepVoidModJeiPlugin"]
  },
  "mixins": ["the_deep_void.mixins.json", "the_deep_void.fabric.mixins.json"],
  "accessWidener": "the_deep_void.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "geckolib": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
